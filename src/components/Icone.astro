  menu: 'M4 7h16M4 12h16M4 17h10',
  tema: 'M12 3a9 9 0 1 0 0 18a9 9 0 0 0 0-18ZM12 3v18M12 7l5.5 0M12 12h9M12 17h5.5',
  feito: 'M4 12.5l5 5L20 6.5',
  seta: 'M5 12h14M13 6l6 6l-6 6',
  volta: 'M19 12H5M11 6l-6 6l6 6',
  relogio: 'M12 4a8 8 0 1 0 0 16a8 8 0 0 0 0-16ZM12 8v4.5l3 2',
  play: 'M7 4.5v15l12-7.5Z',
  pausa: 'M8 5v14M16 5v14',
  reiniciar: 'M5 12a7 7 0 1 0 2.2-5.1M5 4.5V9h4.5',
  fechar: 'M6 6l12 12M18 6L6 18',
  baixar: 'M12 4v11M7 11l5 5l5-5M5 20h14',
  imprimir: 'M7 9V4h10v5M7 17H4v-7h16v7h-3M7 14h10v6H7Z',
  trem: 'M7 4h10a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM5 11h14M8 20l1.5-3M16 20l-1.5-3M9 14h.01M15 14h.01',
};
interface Props {
  nome: keyof typeof TRACOS | string;
  tamanho?: number;
}
const { nome, tamanho = 20 } = Astro.props;
---

<svg
  class="icone"
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d={TRACOS[nome]}></path></svg
>
