---
// Calculadora de preço do curso: tudo roda no navegador, nada é enviado nem guardado.
// A fórmula está à vista na própria página, para o aluno entender de onde vem cada número.
---

<form class="calc" data-calculadora aria-labelledby="calc-t">
  <h3 id="calc-t">Calculadora de preço</h3>
  <p class="calc__aviso">
    Preencha com os <strong>seus</strong> números. Valores de exemplo são só para mostrar a conta; o curso não diz quanto você deve cobrar.
  </p>
  <div class="calc__campos">
    <label>Horas de trabalho estimadas<input type="number" name="horas" min="0" step="0.5" value="20" inputmode="decimal" /></label>
    <label>O seu valor por hora (R$)<input type="number" name="hora" min="0" step="1" value="50" inputmode="decimal" /></label>
    <label>Custos do projeto (R$)<input type="number" name="custos" min="0" step="1" value="150" inputmode="decimal" /><small>Assinatura rateada, domínio, hospedagem, IA. Some o que você paga por causa deste cliente.</small></label>
    <label>Folga para imprevistos (%)<input type="number" name="folga" min="0" max="200" step="1" value="20" inputmode="decimal" /><small>Mudança de ideia, retrabalho, erro do Claude.</small></label>
    <label>Manutenção mensal, horas<input type="number" name="manut" min="0" step="0.5" value="2" inputmode="decimal" /></label>
  </div>
  <output class="calc__saida" aria-live="polite">
    <p><span>Mínimo (cobre trabalho e custos)</span> <strong data-sai="minimo">R$ 0,00</strong></p>
    <p><span>Recomendado (com a folga)</span> <strong data-sai="recomendado">R$ 0,00</strong></p>
    <p><span>Manutenção por mês</span> <strong data-sai="manut">R$ 0,00</strong></p>
  </output>
  <p class="calc__formula">
    Mínimo = horas x valor da hora + custos. Recomendado = mínimo x (1 + folga). Manutenção = horas x valor da hora.
    Impostos e formalização ficam de fora: confira o que se aplica a você.
  </p>
</form>

<script>
  const fmt = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
  document.querySelectorAll<HTMLFormElement>('[data-calculadora]').forEach((f) => {
    const n = (nome: string) => Math.max(0, Number((f.elements.namedItem(nome) as HTMLInputElement)?.value) || 0);
    const mostrar = () => {
      const minimo = n('horas') * n('hora') + n('custos');
      const recomendado = minimo * (1 + n('folga') / 100);
      const manut = n('manut') * n('hora');
      const alvo = (k: string) => f.querySelector<HTMLElement>(`[data-sai="${k}"]`)!;
      alvo('minimo').textContent = fmt.format(minimo);
      alvo('recomendado').textContent = fmt.format(recomendado);
      alvo('manut').textContent = fmt.format(manut);
    };
    f.addEventListener('input', mostrar);
    f.addEventListener('submit', (e) => e.preventDefault());
    mostrar();
  });
</script>

<style>
  .calc {
    margin: var(--e-5) 0;
    padding: var(--e-4) var(--e-5);
    border: 3px solid var(--tinta);
    border-radius: var(--raio);
    background: var(--papel-2);
  }
  .calc h3 {
    margin: 0 0 var(--e-2);
  }
  .calc__aviso,
  .calc__formula {
    font-size: 0.95rem;
    color: var(--tinta-2);
  }
  .calc__campos {
    display: grid;
    gap: var(--e-3);
    margin: var(--e-3) 0;
  }
  label {
    display: grid;
    gap: 0.25rem;
    font-weight: 700;
  }
  small {
    font-weight: 400;
    color: var(--tinta-2);
  }
  input {
    padding: 0.55rem 0.75rem;
    border: 2px solid var(--tinta);
    border-radius: 10px;
    background: var(--papel);
    color: var(--tinta);
    font: inherit;
  }
  .calc__saida {
    display: grid;
    gap: var(--e-2);
    margin: var(--e-3) 0;
    padding: var(--e-3) var(--e-4);
    border-radius: var(--raio-p);
    background: var(--papel);
    border: 2px dashed var(--tinta-3);
  }
  .calc__saida p {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--e-2);
    margin: 0;
  }
  .calc__saida strong {
    font-size: 1.2rem;
  }
  @media (min-width: 40rem) {
    .calc__campos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
