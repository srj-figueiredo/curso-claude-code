---
// Aviso de abertura de cada estação das Temporadas: o que a pessoa vai aprender (em palavras simples)
// e o que vai ouvir mas só aprofunda depois, com o link para o módulo de referência.
import Mascote from './Mascote.astro';
import { estacao, rotulo } from '../data/curso';
import { pagina } from '../lib/url';
import { paginasEscritas } from '../lib/paginas';

interface Aprender {
  termo: string;
  simples: string;
}
interface Depois {
  termo: string;
  quando: string;
  ref?: string;
}
interface Props {
  aprender: Aprender[];
  depois?: Depois[];
}
const { aprender, depois = [] } = Astro.props;
const escritas = await paginasEscritas();
---

<aside class="conceitos" aria-labelledby="conceitos-t">
  <h2 id="conceitos-t" class="conceitos__titulo">
    <Mascote humor="acenando" tamanho={30} />
    <span>Conceitos desta estação</span>
  </h2>
  <p class="conceitos__intro">Ao final, estas ideias deixam de ser palavras estranhas:</p>
  <dl class="conceitos__lista">
    {
      aprender.map((c) => (
        <div class="conceitos__item">
          <dt>{c.termo}</dt>
          <dd>{c.simples}</dd>
        </div>
      ))
    }
  </dl>
  {
    depois.length > 0 && (
      <div class="conceitos__depois">
        <p class="conceitos__intro">
          Você vai <strong>ouvir falar</strong> destas, mas só entra a fundo depois. Quem tiver curiosidade já pode abrir a referência:
        </p>
        <ul>
          {depois.map((c) => {
            const e = c.ref ? estacao(c.ref) : undefined;
            return (
              <li>
                <strong>{c.termo}</strong>: {c.quando}
                {e && (
                  <>
                    {' '}
                    {escritas.has(e.id) ? (
                      <a href={pagina(e.id)}>
                        Referência: {rotulo(e.id)} ({e.titulo})
                      </a>
                    ) : (
                      <span>
                        Referência: {rotulo(e.id)} ({e.titulo}, em obras)
                      </span>
                    )}
                  </>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</aside>

<style>
  .conceitos {
    margin: var(--e-5) 0 var(--e-6);
    padding: var(--e-4) var(--e-5);
    border: 2px solid var(--tinta);
    border-left: 12px solid var(--linha);
    border-radius: var(--raio);
    background: var(--papel-2);
  }
  .conceitos__titulo {
    display: flex;
    align-items: center;
    gap: var(--e-2);
    margin: 0 0 var(--e-2);
    font-size: 1.25rem;
  }
  .conceitos__intro {
    margin: 0 0 var(--e-3);
    color: var(--tinta-2);
  }
  .conceitos__lista {
    display: grid;
    gap: var(--e-3);
    margin: 0;
  }
  .conceitos__item {
    display: grid;
    gap: 0.15rem;
  }
  .conceitos__item dt {
    font-weight: 700;
  }
  .conceitos__item dd {
    margin: 0;
  }
  .conceitos__depois {
    margin-top: var(--e-4);
    padding-top: var(--e-3);
    border-top: 1px dashed var(--tinta-3);
  }
  .conceitos__depois ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .conceitos__depois li + li {
    margin-top: var(--e-2);
  }
  @media (min-width: 52rem) {
    .conceitos__lista {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--e-5);
    }
  }
</style>
